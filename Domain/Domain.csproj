<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- MediatR is the only package this layer is allowed: BaseEvent implements INotification so
         entities can queue domain events. Nothing else belongs here — a PackageReference in Domain
         is a claim about what the innermost layer depends on, and an unused one makes that claim
         falsely. Asp.Versioning, Newtonsoft.Json, System.Data.SqlClient and
         System.IdentityModel.Tokens.Jwt were all referenced here and used by nothing. -->
    <PackageReference Include="MediatR" Version="12.5.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

</Project>
