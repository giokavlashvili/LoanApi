{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.AspNetCore": "Error",
        "Microsoft.EntityFrameworkCore": "Error",
        "System": "Error",
        "System.Net.Http": "Error",
        "NSwag": "Error",
        "Swashbuckle": "Error",
        "LuckyPennySoftware.MediatR.License": "Error"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithEnvironmentName",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "UseInMemoryDatabase": false,
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=LoanDB;Username=postgres;Password=postgres"
  },
  "JWT": {
    "Secret": "JWTAuthenticationHIGHsecuredPasswordVVVp1OH7Xzyr",
    "ExpireMinutes": "180"
  },
  "DefaultLanguage": "en-US",
  "RequestLogging": {
    "MaxBodySizeToLog": 102400,
    "MaxBodySizeToSanitize": 10240,
    "SlowRequestThresholdMs": 1000,
    "ErrorStatusCodeThreshold": 500,
    "WarningStatusCodeThreshold": 400,
    "SkipLoggingPaths": [
      "/swagger",
      "/api/specification",
      "/hubs",
      "/hub"
    ],
    "SkipLoggingExtensions": [
      ".js", ".css", ".png", ".jpg", ".jpeg", ".gif", ".ico", ".svg",
      ".woff", ".woff2", ".ttf", ".eot", ".map", ".json", ".xml",
      ".pdf", ".zip", ".txt", ".html", ".htm"
    ],
    "FileDownloadPatterns": [
      "/download",
      "/file",
      "/video",
      "/audio",
      "/image",
      "/stream",
      "/media",
      "/attachment",
      "/export",
      "/report"
    ],
    "FileEndpointPatterns": [
      "/files/",
      "/videos/",
      "/images/",
      "/documents/",
      "/attachments/"
    ],
    "BinaryFileExtensions": [
      ".mp4", ".avi", ".mov", ".wmv", ".flv", ".webm", ".mkv",
      ".mp3", ".wav", ".flac", ".aac", ".ogg", ".m4a",
      ".pdf", ".zip", ".rar", ".7z", ".tar", ".gz",
      ".exe", ".dll", ".msi", ".deb", ".rpm",
      ".iso", ".img", ".bin"
    ]
  }
}