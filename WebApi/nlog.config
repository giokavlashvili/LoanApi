<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

	<!-- enable asp.net core layout renderers -->
	<extensions>
		<add assembly="NLog.Web.AspNetCore"/>
	</extensions>

	<!--
	  Columns are filled from three sources:
	    ${aspnet-*}          ambient request state, so ANY log event raised during a request
	                         carries correlation id / url / ip / user without extra code
	    ${event-properties}  message template holes (StatusCode, DurationMs, UserId, Channel)
	    ${scopeproperty}     ILogger.BeginScope values — used for the two large bodies so they
	                         do not also get baked into the rendered Message
	  Keep in sync with Domain/Entities/Log.cs and Application/Common/Logging/LogProperties.cs.
	-->
	<targets async="true">
		<!-- File Target for own log messages with extra web details using some ASP.NET core renderers -->
		<target xsi:type="File" name="ownFile-web"
				fileName="${basedir}/logs/${shortdate}.log"
				archiveAboveSize="10485760"
				maxArchiveFiles="14"
				keepFileOpen="true"
				layout="${longdate}|${level:uppercase=true}|${aspnet-traceidentifier}|${logger}|${message} ${exception:format=tostring}|url: ${aspnet-request-url}" />

		<!--Console Target for hosting lifetime messages to improve Docker / Visual Studio startup detection -->
		<target xsi:type="Console" name="lifetimeConsole" layout="${MicrosoftConsoleLayout}" />

		<!--
		  Database target. Wrapped in an AsyncWrapper (via targets async="true") so the SQL
		  INSERT never runs on the request thread — mandatory now that every request produces
		  a row. NLog precalculates the volatile ${aspnet-*} layouts on the request thread
		  before queueing, so HttpContext is still available when they render.
		-->
		<target xsi:type="Database"
				dbProvider="Microsoft.Data.SqlClient.SqlConnection, Microsoft.Data.SqlClient"
				name="dbTarget"
				keepConnection="true"
				commandText="INSERT INTO Logs([When],[Level],[Logger],[Message],[Exception],[CorrelationId],[Method],[Url],[StatusCode],[DurationMs],[UserId],[UserName],[ClientIp],[MachineName],[RequestBody],[ResponseBody],[Channel]) VALUES (@when,@level,@logger,@message,@exception,@correlationId,@method,@url,@statusCode,@durationMs,@userId,@userName,@clientIp,@machineName,@requestBody,@responseBody,@channel)">
			<connectionString>${gdc:item=ConnectionString}</connectionString>

			<!-- Event time in UTC, not insert time: the target is async so the two differ. -->
			<parameter name="@when" layout="${longdate:universalTime=true}" dbType="DateTime" />
			<parameter name="@level" layout="${level}" dbType="String" size="10" />
			<parameter name="@logger" layout="${logger}" dbType="String" size="255" />
			<parameter name="@message" layout="${message}" dbType="String" size="-1" />
			<parameter name="@exception" layout="${exception:format=tostring}" dbType="String" size="-1" allowDbNull="true" />

			<parameter name="@correlationId" layout="${aspnet-traceidentifier}" dbType="String" size="64" allowDbNull="true" />
			<parameter name="@method" layout="${aspnet-request-method}" dbType="String" size="10" allowDbNull="true" />
			<parameter name="@url" layout="${aspnet-request-url:IncludeQueryString=true}" dbType="String" size="2048" allowDbNull="true" />
			<parameter name="@clientIp" layout="${aspnet-request-ip}" dbType="String" size="64" allowDbNull="true" />
			<parameter name="@userName" layout="${aspnet-user-identity}" dbType="String" size="256" allowDbNull="true" />
			<parameter name="@machineName" layout="${machinename}" dbType="String" size="128" allowDbNull="true" />

			<parameter name="@statusCode" layout="${event-properties:item=StatusCode}" dbType="Int32" allowDbNull="true" />
			<parameter name="@durationMs" layout="${event-properties:item=DurationMs}" dbType="Int32" allowDbNull="true" />
			<parameter name="@userId" layout="${event-properties:item=UserId}" dbType="String" size="128" allowDbNull="true" />
			<parameter name="@channel" layout="${event-properties:item=Channel:whenEmpty=Api}" dbType="String" size="20" allowDbNull="true" />

			<parameter name="@requestBody" layout="${scopeproperty:item=RequestBody}" dbType="String" size="-1" allowDbNull="true" />
			<parameter name="@responseBody" layout="${scopeproperty:item=ResponseBody}" dbType="String" size="-1" allowDbNull="true" />
		</target>
	</targets>

	<!-- rules to map from logger name to target -->
	<rules>
		<!--Output hosting lifetime messages to console target for faster startup detection -->
		<logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="lifetimeConsole" final="true" />

		<!--Skip non-critical Microsoft logs and so log only own logs (BlackHole) -->
		<logger name="Microsoft.*" maxlevel="Info" final="true" />
		<logger name="System.Net.Http.*" maxlevel="Info" final="true" />

		<!--
		  One row per HTTP request/response, at Info. This is the only Info level source that
		  reaches the database; everything else has to be Warning or worse to get in, which is
		  what keeps the table from filling with routine framework chatter.
		-->
		<logger name="WebApi.Middlwares.LoggingMiddleware" minlevel="Info" writeTo="dbTarget,ownFile-web" final="true" />

		<!--Application events: warnings, errors, slow handlers-->
		<logger name="*" minlevel="Warning" writeTo="dbTarget" />

		<logger name="*" minlevel="Info" writeTo="ownFile-web" />
		<logger name="*" minlevel="Info" writeTo="lifetimeConsole" />
	</rules>
</nlog>
